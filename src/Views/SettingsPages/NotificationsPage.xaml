<UserControl
  x:Class="WindowsLosslessSwitcher.Views.SettingsPages.NotificationsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:WindowsLosslessSwitcher.Controls">
  <StackPanel>
    <TextBlock
      Text="Notifications"
      FontSize="{StaticResource Nocturne.FontSize.Heading}"
      FontWeight="SemiBold" />
    <Border
      Style="{StaticResource Nocturne.SettingsGroup}">
      <StackPanel>
        <controls:SettingsRow
          Header="Show format-change notifications"
          Description="Show a small notification when the output format changes.">
          <ToggleButton
            IsChecked="{Binding EnableSwitchToasts}"
            AutomationProperties.Name="Show format-change notifications"
            Style="{StaticResource Nocturne.ToggleSwitch}" />
        </controls:SettingsRow>
        <controls:SettingsRow
          Header="Include song details"
          Description="Include artwork, song, artist, and album."
          IsEnabled="{Binding EnableSwitchToasts}">
          <ToggleButton
            IsChecked="{Binding IncludeTrackMetadataInSwitchToasts}"
            AutomationProperties.Name="Include song details in notifications"
            Style="{StaticResource Nocturne.ToggleSwitch}" />
        </controls:SettingsRow>
      </StackPanel>
    </Border>
    <TextBlock
      Text="When song details are off, notifications show only the new audio format."
      TextWrapping="Wrap"
      Foreground="{DynamicResource Nocturne.Brush.Text55}"
      FontSize="{StaticResource Nocturne.FontSize.Small}" />
  </StackPanel>
</UserControl>