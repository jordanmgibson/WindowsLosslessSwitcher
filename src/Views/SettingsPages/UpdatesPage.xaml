<UserControl
  x:Class="WindowsLosslessSwitcher.Views.SettingsPages.UpdatesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:WindowsLosslessSwitcher.Controls">
  <UserControl.Resources>
    <BooleanToVisibilityConverter
      x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <StackPanel>
    <TextBlock
      FontSize="{StaticResource Nocturne.FontSize.Heading}"
      FontWeight="SemiBold"
      Text="Updates"
      TextWrapping="Wrap" />
    <Border
      Margin="0,14,0,0"
      Background="{DynamicResource Nocturne.Brush.Surface}"
      BorderBrush="{DynamicResource Nocturne.Brush.Ring}"
      BorderThickness="1"
      CornerRadius="8"
      Padding="16">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition
              Width="Auto" />
            <ColumnDefinition
              Width="*" />
          </Grid.ColumnDefinitions>
          <Ellipse
            Width="6"
            Height="6"
            VerticalAlignment="Center"
            Fill="{DynamicResource Nocturne.Brush.Accent}" />
          <TextBlock
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            FontSize="{StaticResource Nocturne.FontSize.Body}"
            Text="{Binding UpdateStatusText}"
            TextWrapping="Wrap"
            Grid.Column="1" />
        </Grid>
        <TextBlock
          Margin="0,4,0,0"
          FontSize="{StaticResource Nocturne.FontSize.Note}"
          Foreground="{DynamicResource Nocturne.Brush.Text40}"
          Text="{Binding AppVersionText}"
          TextWrapping="Wrap" />
        <WrapPanel
          Margin="0,14,0,0">
          <Button
            Command="{Binding CheckForUpdatesCommand}"
            Content="Check for updates"
            FontSize="{StaticResource Nocturne.FontSize.Secondary}"
            Style="{StaticResource Nocturne.Button.Primary}"
            Margin="0,0,8,8" />
          <Button
            Margin="0,0,8,8"
            Command="{Binding RunUpdatePrimaryActionCommand}"
            Content="{Binding UpdatePrimaryActionText}"
            FontSize="{StaticResource Nocturne.FontSize.Secondary}"
            Style="{StaticResource Nocturne.Button.Primary}"
            Visibility="{Binding HasUpdatePrimaryAction, Converter={StaticResource BoolToVisibility}}" />
          <Button
            Margin="0,0,8,8"
            Command="{Binding OpenReleasesPageCommand}"
            Content="Open releases"
            FontSize="{StaticResource Nocturne.FontSize.Secondary}"
            Style="{StaticResource Nocturne.Button.Ghost}" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Button
      Margin="0,14,0,0"
      HorizontalAlignment="Left"
      Command="{Binding ExportDiagnosticsCommand}"
      FontSize="{StaticResource Nocturne.FontSize.Secondary}"
      Style="{StaticResource Nocturne.Button.Ghost}">
      <StackPanel
        Orientation="Horizontal">
        <controls:NocturneIcon
          Width="14"
          Height="14"
          VerticalAlignment="Center"
          Geometry="{StaticResource Nocturne.Icon.Export}" />
        <TextBlock
          Margin="6,0,0,0"
          VerticalAlignment="Center"
          Text="Export diagnostics"
          TextWrapping="Wrap" />
      </StackPanel>
    </Button>
  </StackPanel>
</UserControl>