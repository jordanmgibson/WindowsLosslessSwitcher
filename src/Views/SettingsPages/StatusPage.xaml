<UserControl
  x:Class="WindowsLosslessSwitcher.Views.SettingsPages.StatusPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:WindowsLosslessSwitcher.Controls"
  xmlns:converters="clr-namespace:WindowsLosslessSwitcher.Converters">
  <UserControl.Resources>
    <BooleanToVisibilityConverter
      x:Key="BoolToVisibility" />
    <converters:NullToVisibilityConverter
      x:Key="NullToVisibility" />
  </UserControl.Resources>
  <StackPanel>
    <!-- Now-playing card -->
    <Border
      Background="{DynamicResource Nocturne.Brush.Surface}"
      BorderBrush="{DynamicResource Nocturne.Brush.Ring}"
      BorderThickness="1"
      CornerRadius="8"
      Padding="16,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition
            Width="Auto" />
          <ColumnDefinition
            Width="*" />
          <ColumnDefinition
            Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border
          Grid.Column="0"
          Width="52"
          Height="52"
          CornerRadius="6">
          <Border.Background>
            <LinearGradientBrush
              StartPoint="0,0"
              EndPoint="1,1">
              <GradientStop
                Offset="0"
                Color="{Binding ArtworkGlowColor}" />
              <GradientStop
                Offset="1"
                Color="#FF242424" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <controls:NocturneIcon
              Width="20"
              Height="20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Foreground="{DynamicResource Nocturne.Brush.White55}"
              Geometry="{StaticResource Nocturne.Icon.MusicNotes}" />
            <Border
              CornerRadius="6"
              Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}">
              <Border.Background>
                <ImageBrush
                  ImageSource="{Binding ArtworkImage}"
                  Stretch="UniformToFill" />
              </Border.Background>
            </Border>
          </Grid>
        </Border>
        <StackPanel
          Grid.Column="1"
          Margin="14,0"
          VerticalAlignment="Center">
          <TextBlock
            FontSize="{StaticResource Nocturne.FontSize.CardTitle}"
            FontWeight="SemiBold"
            Text="{Binding TrackTitleText}"
            TextTrimming="CharacterEllipsis"
            ToolTip="{Binding TrackTitleText}" />
          <TextBlock
            Margin="0,2,0,0"
            FontSize="{StaticResource Nocturne.FontSize.Secondary}"
            Foreground="{DynamicResource Nocturne.Brush.Text55}"
            Text="{Binding TrackMetaText}"
            TextTrimming="CharacterEllipsis"
            ToolTip="{Binding TrackMetaText}" />
        </StackPanel>
        <Border
          Grid.Column="2"
          VerticalAlignment="Center"
          Background="{DynamicResource Nocturne.Brush.AccentTint}"
          BorderBrush="{DynamicResource Nocturne.Brush.AccentDeep}"
          BorderThickness="1"
          CornerRadius="6"
          Padding="9,3"
          Visibility="{Binding SourceChipText, Converter={StaticResource NullToVisibility}}">
          <TextBlock
            FontSize="{StaticResource Nocturne.FontSize.Small}"
            Foreground="{DynamicResource Nocturne.Brush.AccentLight}"
            Text="{Binding SourceChipText}"
            TextWrapping="Wrap" />
        </Border>
      </Grid>
    </Border>
    <!-- Status row + details disclosure -->
    <Grid
      Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition
          Width="Auto" />
        <ColumnDefinition
          Width="*" />
        <ColumnDefinition
          Width="Auto" />
      </Grid.ColumnDefinitions>
      <Ellipse
        Grid.Column="0"
        VerticalAlignment="Center"
        Style="{StaticResource Nocturne.StatusDot}" />
      <TextBlock
        Grid.Column="1"
        Margin="8,0,0,0"
        VerticalAlignment="Center"
        FontSize="{StaticResource Nocturne.FontSize.Control}"
        Foreground="{DynamicResource Nocturne.Brush.Text70}"
        Text="{Binding PhaseText}"
        TextTrimming="CharacterEllipsis"
        ToolTip="{Binding PhaseText}" />
      <ToggleButton
        x:Name="DetailsToggle"
        Grid.Column="2"
        Style="{StaticResource Nocturne.Disclosure}">
        <StackPanel
          Orientation="Horizontal">
          <TextBlock
            VerticalAlignment="Center"
            Text="Details"
            TextWrapping="Wrap" />
          <controls:NocturneIcon
            Width="12"
            Height="12"
            Margin="5,1,0,0"
            VerticalAlignment="Center"
            Geometry="{StaticResource Nocturne.Icon.CaretDown}">
            <controls:NocturneIcon.Style>
              <Style
                TargetType="controls:NocturneIcon">
                <Style.Triggers>
                  <DataTrigger
                    Binding="{Binding IsChecked, ElementName=DetailsToggle}"
                    Value="True">
                    <Setter
                      Property="LayoutTransform">
                      <Setter.Value>
                        <RotateTransform
                          Angle="180" />
                      </Setter.Value>
                    </Setter>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </controls:NocturneIcon.Style>
          </controls:NocturneIcon>
        </StackPanel>
      </ToggleButton>
    </Grid>
    <!-- Details card -->
    <Border
      Margin="0,8,0,0"
      Background="{DynamicResource Nocturne.Brush.Recessed}"
      BorderBrush="{DynamicResource Nocturne.Brush.Hover}"
      BorderThickness="1"
      CornerRadius="8"
      Padding="14,10"
      Visibility="{Binding IsChecked, ElementName=DetailsToggle, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition
            Width="110" />
          <ColumnDefinition
            Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.Resources>
          <Style
            TargetType="TextBlock">
            <Setter
              Property="FontSize"
              Value="{StaticResource Nocturne.FontSize.Note}" />
            <Setter
              Property="Margin"
              Value="0,0,0,6" />
            <Setter
              Property="TextTrimming"
              Value="CharacterEllipsis" />
          </Style>
        </Grid.Resources>
        <TextBlock
          Grid.Row="0"
          Grid.Column="0"
          Foreground="{DynamicResource Nocturne.Brush.Text40}"
          Text="Requested"
          TextWrapping="Wrap" />
        <TextBlock
          Grid.Row="0"
          Grid.Column="1"
          Foreground="{DynamicResource Nocturne.Brush.Text75}"
          TextWrapping="Wrap">
          <Run
            Text="{Binding RequestedFormatDisplayText, Mode=OneWay}" />
          <Run
            Text=" · " />
          <Run
            Text="{Binding SourceRawText, Mode=OneWay}" />
        </TextBlock>
        <TextBlock
          Grid.Row="1"
          Grid.Column="0"
          Foreground="{DynamicResource Nocturne.Brush.Text40}"
          Text="Applied"
          TextWrapping="Wrap" />
        <TextBlock
          Grid.Row="1"
          Grid.Column="1"
          Foreground="{DynamicResource Nocturne.Brush.Text75}"
          Text="{Binding AppliedFormatDisplayText}"
          TextWrapping="Wrap" />
        <TextBlock
          Grid.Row="2"
          Grid.Column="0"
          Foreground="{DynamicResource Nocturne.Brush.Text40}"
          Text="Resolver"
          TextWrapping="Wrap" />
        <TextBlock
          Grid.Row="2"
          Grid.Column="1"
          Foreground="{DynamicResource Nocturne.Brush.Text75}"
          Text="{Binding ResolverStatusText}"
          TextWrapping="Wrap" />
        <TextBlock
          Grid.Row="3"
          Grid.Column="0"
          Margin="0"
          Foreground="{DynamicResource Nocturne.Brush.Text40}"
          Text="Failure"
          TextWrapping="Wrap" />
        <TextBlock
          Grid.Row="3"
          Grid.Column="1"
          Margin="0"
          Foreground="{DynamicResource Nocturne.Brush.Text75}"
          Text="{Binding FailureReasonText}"
          TextWrapping="Wrap" />
      </Grid>
    </Border>
    <!-- Stat cards -->
    <Grid
      Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition
          Width="*" />
        <ColumnDefinition
          Width="12" />
        <ColumnDefinition
          Width="*" />
      </Grid.ColumnDefinitions>
      <Border
        Grid.Column="0"
        Background="{DynamicResource Nocturne.Brush.Surface}"
        BorderBrush="{DynamicResource Nocturne.Brush.Ring}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="16,14">
        <StackPanel>
          <TextBlock
            Style="{StaticResource Nocturne.Kicker}"
            Text="Requested"
            TextWrapping="Wrap" />
          <TextBlock
            Margin="0,6,0,0"
            FontSize="{StaticResource Nocturne.FontSize.Readout}"
            FontWeight="SemiBold"
            Foreground="{DynamicResource Nocturne.Brush.AccentLight}"
            Text="{Binding RequestedFormatDisplayText}"
            TextWrapping="Wrap" />
          <TextBlock
            Margin="0,2,0,0"
            FontSize="{StaticResource Nocturne.FontSize.Small}"
            Foreground="{DynamicResource Nocturne.Brush.Text40}"
            Text="{Binding SourceChipText}"
            TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border
        Grid.Column="2"
        Background="{DynamicResource Nocturne.Brush.Surface}"
        BorderBrush="{DynamicResource Nocturne.Brush.Ring}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="16,14">
        <StackPanel>
          <TextBlock
            Style="{StaticResource Nocturne.Kicker}"
            Text="Applied on device"
            TextWrapping="Wrap" />
          <TextBlock
            Margin="0,6,0,0"
            FontSize="{StaticResource Nocturne.FontSize.Readout}"
            FontWeight="SemiBold"
            Foreground="{DynamicResource Nocturne.Brush.AccentLight}"
            Text="{Binding AppliedFormatDisplayText}"
            TextWrapping="Wrap" />
          <TextBlock
            Margin="0,2,0,0"
            FontSize="{StaticResource Nocturne.FontSize.Small}"
            Foreground="{DynamicResource Nocturne.Brush.Text40}"
            Text="shared-mode format"
            TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
    <!-- Output device chips -->
    <StackPanel
      Margin="0,18,0,0">
      <TextBlock
        Style="{StaticResource Nocturne.Kicker}"
        Text="Output device"
        TextWrapping="Wrap" />
      <TextBlock
        Margin="0,5,0,0"
        FontSize="{StaticResource Nocturne.FontSize.Body}"
        Text="{Binding ActiveTargetDeviceNameText}"
        TextTrimming="CharacterEllipsis"
        ToolTip="{Binding ActiveTargetDeviceNameText}" />
      <ItemsControl
        Margin="0,10,0,0"
        ItemsSource="{Binding StatusRateChips}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border
              Margin="0,0,6,6"
              BorderThickness="1"
              CornerRadius="6"
              Padding="9,3">
              <Border.Style>
                <Style
                  TargetType="Border">
                  <Setter
                    Property="Background"
                    Value="{DynamicResource Nocturne.Brush.Hover}" />
                  <Setter
                    Property="BorderBrush"
                    Value="{DynamicResource Nocturne.Brush.Ring}" />
                  <Style.Triggers>
                    <DataTrigger
                      Binding="{Binding IsActive}"
                      Value="True">
                      <Setter
                        Property="Background"
                        Value="{DynamicResource Nocturne.Brush.AccentTint}" />
                      <Setter
                        Property="BorderBrush"
                        Value="{DynamicResource Nocturne.Brush.Accent}" />
                    </DataTrigger>
                    <DataTrigger
                      Binding="{Binding IsAllowed}"
                      Value="False">
                      <Setter
                        Property="Opacity"
                        Value="0.3" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock
                FontSize="{StaticResource Nocturne.FontSize.Note}"
                Text="{Binding Label}"
                TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style
                    TargetType="TextBlock">
                    <Setter
                      Property="Foreground"
                      Value="{DynamicResource Nocturne.Brush.Text50}" />
                    <Style.Triggers>
                      <DataTrigger
                        Binding="{Binding IsActive}"
                        Value="True">
                        <Setter
                          Property="Foreground"
                          Value="{DynamicResource Nocturne.Brush.AccentLight}" />
                      </DataTrigger>
                      <DataTrigger
                        Binding="{Binding IsAllowed}"
                        Value="False">
                        <Setter
                          Property="TextDecorations"
                          Value="Strikethrough" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl
        ItemsSource="{Binding StatusBitChips}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border
              Margin="0,0,6,6"
              BorderThickness="1"
              CornerRadius="6"
              Padding="9,3">
              <Border.Style>
                <Style
                  TargetType="Border">
                  <Setter
                    Property="Background"
                    Value="{DynamicResource Nocturne.Brush.Hover}" />
                  <Setter
                    Property="BorderBrush"
                    Value="{DynamicResource Nocturne.Brush.Ring}" />
                  <Style.Triggers>
                    <DataTrigger
                      Binding="{Binding IsActive}"
                      Value="True">
                      <Setter
                        Property="Background"
                        Value="{DynamicResource Nocturne.Brush.AccentTint}" />
                      <Setter
                        Property="BorderBrush"
                        Value="{DynamicResource Nocturne.Brush.Accent}" />
                    </DataTrigger>
                    <DataTrigger
                      Binding="{Binding IsAllowed}"
                      Value="False">
                      <Setter
                        Property="Opacity"
                        Value="0.3" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock
                FontSize="{StaticResource Nocturne.FontSize.Note}"
                Text="{Binding Label}"
                TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style
                    TargetType="TextBlock">
                    <Setter
                      Property="Foreground"
                      Value="{DynamicResource Nocturne.Brush.Text50}" />
                    <Style.Triggers>
                      <DataTrigger
                        Binding="{Binding IsActive}"
                        Value="True">
                        <Setter
                          Property="Foreground"
                          Value="{DynamicResource Nocturne.Brush.AccentLight}" />
                      </DataTrigger>
                      <DataTrigger
                        Binding="{Binding IsAllowed}"
                        Value="False">
                        <Setter
                          Property="TextDecorations"
                          Value="Strikethrough" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <!-- Activity -->
    <StackPanel
      Margin="0,18,0,0">
      <TextBlock
        Style="{StaticResource Nocturne.Kicker}"
        Text="Activity"
        TextWrapping="Wrap" />
      <ItemsControl
        Margin="0,6,0,0"
        ItemsSource="{Binding ActivityLog}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border
              BorderBrush="{DynamicResource Nocturne.Brush.Hairline06}"
              BorderThickness="0,0,0,1"
              Padding="0,6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition
                    Width="Auto" />
                  <ColumnDefinition
                    Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                  Grid.Column="0"
                  Margin="0,1,12,0"
                  FontFamily="{StaticResource Nocturne.FontFamily.Mono}"
                  FontSize="{StaticResource Nocturne.FontSize.Small}"
                  Foreground="{DynamicResource Nocturne.Brush.Text35}"
                  Text="{Binding TimeText}"
                  TextWrapping="Wrap" />
                <TextBlock
                  Grid.Column="1"
                  FontSize="{StaticResource Nocturne.FontSize.Secondary}"
                  Foreground="{DynamicResource Nocturne.Brush.Text70}"
                  Text="{Binding Text}"
                  TextWrapping="Wrap" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock
        Margin="0,6,0,0"
        FontSize="{StaticResource Nocturne.FontSize.Note}"
        Foreground="{DynamicResource Nocturne.Brush.Text35}"
        Text="No activity yet — play something in Apple Music."
        TextWrapping="Wrap">
        <TextBlock.Style>
          <Style
            TargetType="TextBlock">
            <Setter
              Property="Visibility"
              Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger
                Binding="{Binding ActivityLog.Count}"
                Value="0">
                <Setter
                  Property="Visibility"
                  Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
  </StackPanel>
</UserControl>