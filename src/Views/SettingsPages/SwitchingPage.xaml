<UserControl x:Class="WindowsLosslessSwitcher.Views.SettingsPages.SwitchingPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:WindowsLosslessSwitcher.Controls" xmlns:converters="clr-namespace:WindowsLosslessSwitcher.Converters">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:EqualityToBoolConverter x:Key="EqualityToBool" />
    <converters:SampleRateLabelConverter x:Key="RateLabel" />
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="Switching" FontSize="{StaticResource Nocturne.FontSize.Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Margin="0,8,0,12" Text="Match the output device to each track’s audio format." TextWrapping="Wrap" Foreground="{DynamicResource Nocturne.Brush.Text55}" />
    <TextBlock Text="Output device" Style="{StaticResource Nocturne.Kicker}" TextWrapping="Wrap" />
    <Border Style="{StaticResource Nocturne.SettingsGroup}">
      <StackPanel>
        <WrapPanel>
          <RadioButton Content="Follow default device" GroupName="DeviceMode" AutomationProperties.Name="Follow default output device" IsChecked="{Binding SelectedMode, Converter={StaticResource EqualityToBool}, ConverterParameter=FollowDefault}" Style="{StaticResource Nocturne.SegmentedOption}" />
          <RadioButton Content="Choose a device" GroupName="DeviceMode" AutomationProperties.Name="Choose a fixed output device" IsChecked="{Binding SelectedMode, Converter={StaticResource EqualityToBool}, ConverterParameter=PinnedDevice}" Style="{StaticResource Nocturne.SegmentedOption}" />
        </WrapPanel>
        <ListBox Margin="0,12,0,0" ItemsSource="{Binding Devices}" SelectedValue="{Binding SelectedDeviceId}" SelectedValuePath="Id" AutomationProperties.Name="Output device" Style="{StaticResource Nocturne.DeviceList}" Visibility="{Binding IsSelectedDeviceSelectionVisible, Converter={StaticResource BoolToVisibility}}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding FriendlyName}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding RefreshDevicesCommand}" Content="Refresh devices" Style="{StaticResource Nocturne.Button.Ghost}" />
      </StackPanel>
    </Border>
    <TextBlock Margin="0,8,0,0" Text="Playback" Style="{StaticResource Nocturne.Kicker}" TextWrapping="Wrap" />
    <Border Style="{StaticResource Nocturne.SettingsGroup}">
      <StackPanel>
        <controls:SettingsRow Header="Replay the intro after a format change" Description="Mute while checking the format, then restart at 0:00 after a change.">
          <ToggleButton IsChecked="{Binding RewindAfterFormatSwitch}" AutomationProperties.Name="Replay the intro after a format change" Style="{StaticResource Nocturne.ToggleSwitch}" />
        </controls:SettingsRow>
        <controls:SettingsRow Header="Match the track’s bit depth" Description="Match bit depth as well as sample rate.">
          <ToggleButton IsChecked="{Binding SwitchBitDepth}" AutomationProperties.Name="Match the track's bit depth" Style="{StaticResource Nocturne.ToggleSwitch}" />
        </controls:SettingsRow>
        <controls:SettingsRow Header="Default bit depth" Description="Used when bit-depth matching is off." Visibility="{Binding UseFixedBitDepthSelection, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="16-bit" GroupName="DefaultDepth" IsChecked="{Binding DefaultBitDepth, Converter={StaticResource EqualityToBool}, ConverterParameter=16}" Style="{StaticResource Nocturne.SegmentedOption}" />
            <RadioButton Content="24-bit" GroupName="DefaultDepth" IsChecked="{Binding DefaultBitDepth, Converter={StaticResource EqualityToBool}, ConverterParameter=24}" Style="{StaticResource Nocturne.SegmentedOption}" />
          </StackPanel>
        </controls:SettingsRow>

      </StackPanel>
    </Border>
    <TextBlock Margin="0,8,0,0" Text="Native format correction" Style="{StaticResource Nocturne.Kicker}" TextWrapping="Wrap" />
    <Border Style="{StaticResource Nocturne.SettingsGroup}">
      <StackPanel>
        <TextBlock Text="{Binding CurrentTrackText}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Nocturne.Brush.Text55}" TextWrapping="Wrap" Text="If Apple Music’s Lossless details show a different format, save it for this recording and album. Other tracks stay automatic." />
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Label Content="Sample rate" Target="{Binding ElementName=NativeRate}" Padding="0,0,0,6" Foreground="{DynamicResource Nocturne.Brush.Text}" />
            <ComboBox x:Name="NativeRate" ItemsSource="{Binding NativeSampleRateOptions}" SelectedItem="{Binding NativeSampleRateHz}" AutomationProperties.Name="Native sample rate" AutomationProperties.HelpText="Use the sample rate shown in Apple Music’s Lossless details.">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource RateLabel}}" TextWrapping="Wrap" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <Label Content="Bit depth" Target="{Binding ElementName=NativeDepth}" Padding="0,0,0,6" Foreground="{DynamicResource Nocturne.Brush.Text}" />
            <ComboBox x:Name="NativeDepth" ItemsSource="{Binding NativeBitDepthOptions}" SelectedItem="{Binding NativeBitDepth}" AutomationProperties.Name="Native bit depth">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding StringFormat={}{0}-bit}" TextWrapping="Wrap" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>
        <WrapPanel Margin="0,16,0,0">
          <Button Content="Save and apply" Margin="0,0,8,8" Command="{Binding SaveNativeFormatCorrectionCommand}" Style="{StaticResource Nocturne.Button.Primary}" />
          <Button Content="Remove correction" Margin="0,0,0,8" Command="{Binding RemoveNativeFormatCorrectionCommand}" Style="{StaticResource Nocturne.Button.Ghost}" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Expander Margin="0,8,0,16" Header="Device limits and recovery" Foreground="{DynamicResource Nocturne.Brush.Text}" AutomationProperties.Name="Advanced device limits and recovery">
      <StackPanel Margin="0,12,0,0">
        <Border Style="{StaticResource Nocturne.SettingsGroup}">
          <StackPanel>
            <TextBlock Text="Device limits" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,12" Text="Restrict formats only if another device in your audio chain needs it. Leave all formats selected for automatic matching." TextWrapping="Wrap" Foreground="{DynamicResource Nocturne.Brush.Text55}" />
            <TextBlock Text="Sample rates" FontSize="{StaticResource Nocturne.FontSize.Small}" TextWrapping="Wrap" />
            <ItemsControl Margin="0,8,0,8" ItemsSource="{Binding SampleRateOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton Margin="0,0,8,8" Content="{Binding Label}" AutomationProperties.Name="{Binding Label}" IsChecked="{Binding IsChecked}" Style="{StaticResource Nocturne.Chip.Allowed}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Bit depths" FontSize="{StaticResource Nocturne.FontSize.Small}" TextWrapping="Wrap" />
            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding BitDepthOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ToggleButton Margin="0,0,8,8" Content="{Binding Label}" AutomationProperties.Name="{Binding Label}" IsChecked="{Binding IsChecked}" Style="{StaticResource Nocturne.Chip.Allowed}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding AllowedFormatsNoteText}" TextWrapping="Wrap" Foreground="{DynamicResource Nocturne.Brush.Text55}" FontSize="{StaticResource Nocturne.FontSize.Small}" />
          <controls:SettingsRow Header="Fallback when the exact rate is unsupported" Description="Prefer an available half-rate to an unrelated rate. Supported native rates are always used first.">
          <ToggleButton IsChecked="{Binding PreferClosestSampleRateMultiple}" AutomationProperties.Name="Prefer a related sample rate" Style="{StaticResource Nocturne.ToggleSwitch}" />
        </controls:SettingsRow></StackPanel>
        </Border>
        <Border Style="{StaticResource Nocturne.SettingsGroup}">
          <StackPanel>
            <controls:SettingsRow Header="Restart Apple Music if recovery fails" Description="Last resort only. The Apple Music queue may reset.">
              <ToggleButton IsChecked="{Binding RestartAppleMusicOnPlaybackFailure}" AutomationProperties.Name="Restart Apple Music if recovery fails" Style="{StaticResource Nocturne.ToggleSwitch}" />
            </controls:SettingsRow>
            <controls:SettingsRow Header="Detailed diagnostics" Description="Include additional troubleshooting information in the local log.">
              <ToggleButton IsChecked="{Binding EnableVerboseDiagnostics}" AutomationProperties.Name="Detailed diagnostics" Style="{StaticResource Nocturne.ToggleSwitch}" />
            </controls:SettingsRow>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Nocturne.SettingsGroup}">
          <StackPanel>
            <TextBlock Text="Original device format" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0" Text="{Binding OriginalFormatText}" Foreground="{DynamicResource Nocturne.Brush.Text55}" TextWrapping="Wrap" />
            <Button Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding RestoreOriginalFormatCommand}" Content="Restore original format" Style="{StaticResource Nocturne.Button.Ghost}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>