<Window x:Class="WindowsLosslessSwitcher.Views.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WindowsLosslessSwitcher.Controls"
        Title="Lossless Switcher"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource Nocturne.FontFamily}"
        Foreground="{StaticResource Nocturne.Brush.Text}"
        ResizeMode="NoResize"
        ShowActivated="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        TextOptions.TextFormattingMode="Display"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>
  <!-- Transparent margin for the popup shadow. -->
  <Border Width="312"
          Margin="16"
          Background="{StaticResource Nocturne.Brush.Ground}"
          BorderBrush="{StaticResource Nocturne.Brush.Ring}"
          BorderThickness="1"
          CornerRadius="8"
          Padding="6"
          SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28"
                        Direction="270"
                        Opacity="0.6"
                        ShadowDepth="8"
                        Color="#FF000000" />
    </Border.Effect>
    <StackPanel>

      <!-- Now playing row -->
      <Grid Margin="10,9">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                Width="42"
                Height="42"
                CornerRadius="5">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Offset="0" Color="{Binding ArtworkGlowColor}" />
              <GradientStop Offset="1" Color="#FF1B1D2B" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <controls:NocturneIcon Width="16"
                                   Height="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Nocturne.Brush.White55}"
                                   Geometry="{StaticResource Nocturne.Icon.MusicNotes}" />
            <Border CornerRadius="5" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}">
              <Border.Background>
                <ImageBrush ImageSource="{Binding ArtworkImage}" Stretch="UniformToFill" />
              </Border.Background>
            </Border>
          </Grid>
        </Border>
        <StackPanel Grid.Column="1"
                    Margin="11,0"
                    VerticalAlignment="Center">
          <TextBlock FontSize="{StaticResource Nocturne.FontSize.Control}"
                     FontWeight="Medium"
                     Text="{Binding TrackTitleText}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Margin="0,1,0,0"
                     FontSize="{StaticResource Nocturne.FontSize.Small}"
                     Foreground="{StaticResource Nocturne.Brush.Text50}"
                     Text="{Binding TrackMetaText}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Border Grid.Column="2"
                VerticalAlignment="Center"
                Background="{StaticResource Nocturne.Brush.AccentTint}"
                BorderBrush="{StaticResource Nocturne.Brush.AccentDeep}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,3">
          <TextBlock FontSize="{StaticResource Nocturne.FontSize.Small}"
                     Foreground="{StaticResource Nocturne.Brush.AccentLight}"
                     Text="{Binding CurrentDeviceFormatText}" />
        </Border>
      </Grid>

      <!-- Status line -->
      <StackPanel Margin="10,0,10,8" Orientation="Horizontal">
        <Ellipse VerticalAlignment="Center" Style="{StaticResource Nocturne.StatusDot}" />
        <TextBlock Margin="7,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="{StaticResource Nocturne.FontSize.Note}"
                   Foreground="{StaticResource Nocturne.Brush.Text55}"
                   Text="{Binding PhaseText}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <Control Margin="10,0" Style="{StaticResource Nocturne.Divider.Tray}" />

      <!-- Menu rows -->
      <StackPanel Margin="0,5">
        <Button x:Name="CheckForUpdatesButton"
                Click="MenuRow_OnClick"
                Command="{Binding CheckForUpdatesCommand}">
          <Button.Style>
            <Style BasedOn="{StaticResource Nocturne.MenuRow}" TargetType="Button">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasUpdatePrimaryAction}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <StackPanel Orientation="Horizontal">
            <controls:NocturneIcon Width="15"
                                   Height="15"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Nocturne.Brush.Text50}"
                                   Geometry="{StaticResource Nocturne.Icon.ArrowsClockwise}" />
            <TextBlock Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="Check for updates" />
          </StackPanel>
        </Button>
        <Button Click="MenuRow_OnClick"
                Command="{Binding RunUpdatePrimaryActionCommand}"
                Style="{StaticResource Nocturne.MenuRow}"
                Visibility="{Binding HasUpdatePrimaryAction, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <controls:NocturneIcon Width="15"
                                   Height="15"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Nocturne.Brush.Text50}"
                                   Geometry="{StaticResource Nocturne.Icon.ArrowCircleUp}" />
            <TextBlock Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding UpdatePrimaryActionText}" />
          </StackPanel>
        </Button>
        <Button Click="MenuRow_OnClick"
                Command="{Binding OpenReleasesPageCommand}"
                Style="{StaticResource Nocturne.MenuRow}">
          <StackPanel Orientation="Horizontal">
            <controls:NocturneIcon Width="15"
                                   Height="15"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Nocturne.Brush.Text50}"
                                   Geometry="{StaticResource Nocturne.Icon.ArrowSquareOut}" />
            <TextBlock Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="Open releases" />
          </StackPanel>
        </Button>
        <Button Click="OpenSettingsRow_OnClick" Style="{StaticResource Nocturne.MenuRow}">
          <StackPanel Orientation="Horizontal">
            <controls:NocturneIcon Width="15"
                                   Height="15"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Nocturne.Brush.Text50}"
                                   Geometry="{StaticResource Nocturne.Icon.Gear}" />
            <TextBlock Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="Open settings" />
          </StackPanel>
        </Button>
        <Button Click="ExitRow_OnClick" Style="{StaticResource Nocturne.MenuRow}">
          <StackPanel Orientation="Horizontal">
            <controls:NocturneIcon Width="15"
                                   Height="15"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Nocturne.Brush.Text50}"
                                   Geometry="{StaticResource Nocturne.Icon.SignOut}" />
            <TextBlock Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Text="Exit" />
          </StackPanel>
        </Button>
      </StackPanel>

      <Control Margin="10,0" Style="{StaticResource Nocturne.Divider.Tray}" />

      <TextBlock Margin="10,8"
                 FontSize="{StaticResource Nocturne.FontSize.Faint}"
                 Foreground="{StaticResource Nocturne.Brush.Text35}"><Run Text="{Binding AppVersionText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding UpdateBadgeText, Mode=OneWay}" /></TextBlock>

    </StackPanel>
  </Border>
</Window>
