<controls:NocturneWindow
  x:Class="WindowsLosslessSwitcher.Views.HeroWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:WindowsLosslessSwitcher.Controls"
  xmlns:converters="clr-namespace:WindowsLosslessSwitcher.Converters"
  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  Title="Windows Lossless Switcher"
  Width="440"
  Background="{DynamicResource Nocturne.Brush.Ground}"
  FontFamily="{StaticResource Nocturne.FontFamily}"
  Foreground="{DynamicResource Nocturne.Brush.Text}"
  ResizeMode="CanMinimize"
  ShowInTaskbar="True"
  SizeToContent="Height"
  TextOptions.TextFormattingMode="Display"
  WindowStartupLocation="CenterScreen">
  <controls:NocturneWindow.InputBindings>
    <KeyBinding
      Gesture="Ctrl+OemComma"
      Command="{Binding OpenAllSettingsCommand}" />
  </controls:NocturneWindow.InputBindings>
  <controls:NocturneWindow.Resources>
    <BooleanToVisibilityConverter
      x:Key="BoolToVisibility" />
  </controls:NocturneWindow.Resources>
  <Border
    BorderBrush="{DynamicResource Nocturne.Brush.Ring}"
    BorderThickness="1"
    Background="{DynamicResource Nocturne.Brush.Ground}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition
          Height="42" />
        <RowDefinition
          Height="*" />
      </Grid.RowDefinitions>
      <Grid
        Height="42">
        <StackPanel
          Margin="16,0,0,0"
          VerticalAlignment="Center"
          Orientation="Horizontal">
          <controls:MiniSpectrograph
            x:Name="TitleBarSpectrograph"
            Width="22"
            Height="15" />
          <TextBlock
            Margin="9,0,0,0"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{DynamicResource Nocturne.Brush.Text45}"
            Text="Lossless Switcher" />
        </StackPanel>
        <StackPanel
          Margin="0,0,6,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button
            Click="MinimizeButton_OnClick"
            Style="{StaticResource Nocturne.CaptionButton}"
            AutomationProperties.Name="Minimize"
            ToolTip="Minimize">
            <controls:NocturneIcon
              Width="13"
              Height="13"
              Geometry="{StaticResource Nocturne.Icon.Minus}" />
          </Button>
          <Button
            Click="CloseButton_OnClick"
            Style="{StaticResource Nocturne.CaptionButton.Close}"
            AutomationProperties.Name="Close window"
            ToolTip="Close window">
            <controls:NocturneIcon
              Width="13"
              Height="13"
              Geometry="{StaticResource Nocturne.Icon.X}" />
          </Button>
        </StackPanel>
      </Grid>
      <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Grid.Row="1">
        <StackPanel>
          <!-- Title bar (42px drag region) -->
          <!-- Hero -->
          <StackPanel
            Margin="28,20,28,24">
            <!-- Artwork 176×176 with hue glow -->
            <Border
              Width="176"
              Height="176"
              HorizontalAlignment="Center"
              CornerRadius="8">
              <Border.Background>
                <LinearGradientBrush
                  StartPoint="0,0"
                  EndPoint="1,1">
                  <GradientStop
                    Offset="0"
                    Color="{Binding ArtworkGlowColor}" />
                  <GradientStop
                    Offset="1"
                    Color="#FF242424" />
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect>
                <DropShadowEffect
                  BlurRadius="60"
                  Direction="270"
                  Opacity="0.55"
                  ShadowDepth="14"
                  Color="{Binding ArtworkGlowColor}" />
              </Border.Effect>
              <Grid>
                <controls:NocturneIcon
                  Width="34"
                  Height="34"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource Nocturne.Brush.White55}"
                  Geometry="{StaticResource Nocturne.Icon.MusicNotes}" />
                <Border
                  CornerRadius="8"
                  Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}">
                  <Border.Background>
                    <ImageBrush
                      ImageSource="{Binding ArtworkImage}"
                      Stretch="UniformToFill" />
                  </Border.Background>
                </Border>
              </Grid>
            </Border>
            <TextBlock
              Margin="0,18,0,0"
              HorizontalAlignment="Center"
              FontSize="{StaticResource Nocturne.FontSize.HeroTitle}"
              FontWeight="SemiBold"
              Text="{Binding TrackTitleText}"
              TextAlignment="Center"
              TextTrimming="CharacterEllipsis"
              ToolTip="{Binding TrackTitleText}" />
            <TextBlock
              Margin="0,3,0,0"
              HorizontalAlignment="Center"
              FontSize="{StaticResource Nocturne.FontSize.Control}"
              Foreground="{DynamicResource Nocturne.Brush.Text55}"
              Text="{Binding TrackMetaText}"
              TextAlignment="Center"
              TextTrimming="CharacterEllipsis"
              ToolTip="{Binding TrackMetaText}" />
            <TextBlock
              Margin="0,18,0,0"
              HorizontalAlignment="Center"
              FontSize="{StaticResource Nocturne.FontSize.ReadoutHero}"
              FontWeight="SemiBold"
              Foreground="{DynamicResource Nocturne.Brush.AccentLight}"
              Text="{Binding AppliedFormatDisplayText}" />
            <TextBlock
              Margin="0,4,0,0"
              HorizontalAlignment="Center"
              FontSize="{StaticResource Nocturne.FontSize.Note}"
              Foreground="{DynamicResource Nocturne.Brush.Text35}"
              Text="{Binding WasLine}" />
            <StackPanel
              Margin="0,12,0,0"
              HorizontalAlignment="Center"
              Orientation="Horizontal">
              <Ellipse
                VerticalAlignment="Center"
                Style="{StaticResource Nocturne.StatusDot}" />
              <TextBlock
                Margin="7,0,0,0"
                VerticalAlignment="Center"
                FontSize="{StaticResource Nocturne.FontSize.Secondary}"
                Foreground="{DynamicResource Nocturne.Brush.Text70}"
                Text="{Binding PhaseText}"
                TextWrapping="Wrap"
                MaxWidth="330" />
            </StackPanel>
          </StackPanel>
          <Control
            Style="{StaticResource Nocturne.Divider}" />
          <!-- Lower panel -->
          <StackPanel
            Margin="28,16,28,22">
            <Grid
              Margin="0,6,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="*" />
                <ColumnDefinition
                  Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel
                Grid.Column="0">
                <TextBlock
                  Style="{StaticResource Nocturne.Kicker}"
                  Text="Output device" />
                <TextBlock
                  Margin="0,3,0,0"
                  FontSize="{StaticResource Nocturne.FontSize.Body}"
                  Text="{Binding ActiveTargetDeviceNameText}"
                  TextTrimming="CharacterEllipsis"
                  ToolTip="{Binding ActiveTargetDeviceNameText}" />
              </StackPanel>
              <Border
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Background="{DynamicResource Nocturne.Brush.Hover}"
                BorderBrush="{DynamicResource Nocturne.Brush.Ring}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="9,3">
                <TextBlock
                  FontSize="{StaticResource Nocturne.FontSize.Small}"
                  Foreground="{DynamicResource Nocturne.Brush.Text55}"
                  Text="{Binding DeviceModeChipText}" />
              </Border>
            </Grid>
            <Grid
              Margin="0,9,0,9">
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="*" />
                <ColumnDefinition
                  Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                VerticalAlignment="Center"
                FontSize="{StaticResource Nocturne.FontSize.Body}"
                Text="Match bit depth"
                TextWrapping="Wrap"
                Margin="0,0,16,0" />
              <ToggleButton
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                IsChecked="{Binding SwitchBitDepth}"
                Style="{StaticResource Nocturne.ToggleSwitch}"
                AutomationProperties.Name="Match the track’s bit depth"
                Grid.Column="1" />
            </Grid>
            <Grid
              Margin="0,9,0,9">
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="*" />
                <ColumnDefinition
                  Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                VerticalAlignment="Center"
                FontSize="{StaticResource Nocturne.FontSize.Body}"
                Text="Notify when the format changes"
                TextWrapping="Wrap"
                Margin="0,0,16,0" />
              <ToggleButton
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                IsChecked="{Binding EnableSwitchToasts}"
                Style="{StaticResource Nocturne.ToggleSwitch}"
                AutomationProperties.Name="Show a notification when the format changes"
                Grid.Column="1" />
            </Grid>
            <Grid
              Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  Width="*" />
                <ColumnDefinition
                  Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button
                Grid.Column="0"
                Command="{Binding OpenAllSettingsCommand}"
                Content="All settings"
                Padding="14,8"
                Style="{StaticResource Nocturne.Button.Primary}" />
              <Button
                Grid.Column="1"
                Margin="8,0,0,0"
                Command="{Binding ExportDiagnosticsCommand}"
                Padding="12,8"
                Style="{StaticResource Nocturne.Button.Ghost}">
                <StackPanel
                  Orientation="Horizontal">
                  <controls:NocturneIcon
                    Width="14"
                    Height="14"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Nocturne.Brush.Text70}"
                    Geometry="{StaticResource Nocturne.Icon.Export}" />
                  <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Text="Diagnostics" />
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</controls:NocturneWindow>