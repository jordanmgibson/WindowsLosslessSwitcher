<Window x:Class="WindowsLosslessSwitcher.Views.SwitchToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WindowsLosslessSwitcher.Controls"
        Title="Switch Toast"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource Nocturne.FontFamily}"
        Foreground="{StaticResource Nocturne.Brush.Text}"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        TextOptions.TextFormattingMode="Display"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
  <!-- Outer transparent margin keeps the drop shadow unclipped. -->
  <Grid Margin="28">

    <!-- 1c rich card -->
    <Border x:Name="RichRoot"
            Width="360"
            Background="{StaticResource Nocturne.Brush.Surface}"
            BorderBrush="{StaticResource Nocturne.Brush.MidRing}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14"
            SnapsToDevicePixels="True">
      <Border.Effect>
        <DropShadowEffect BlurRadius="32"
                          Direction="270"
                          Opacity="0.6"
                          ShadowDepth="8"
                          Color="#FF000000" />
      </Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Width="56"
                Height="56"
                VerticalAlignment="Top"
                CornerRadius="6">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Offset="0" Color="#FF423A6A" />
              <GradientStop Offset="1" Color="#FF1B1D2B" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <controls:NocturneIcon Width="22"
                                   Height="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Nocturne.Brush.White55}"
                                   Geometry="{StaticResource Nocturne.Icon.MusicNotes}" />
            <Border x:Name="RichArtworkHost"
                    CornerRadius="6"
                    Visibility="Collapsed">
              <Border.Background>
                <ImageBrush x:Name="RichArtworkBrush" Stretch="UniformToFill" />
              </Border.Background>
            </Border>
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="13,0,0,0">
          <Grid>
            <TextBlock x:Name="KickerText"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource Nocturne.FontSize.Kicker}"
                       Foreground="{StaticResource Nocturne.Brush.Text45}" />
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseButton_OnClick"
                    Cursor="Hand"
                    Focusable="False"
                    Foreground="{StaticResource Nocturne.Brush.Text40}"
                    ToolTip="Dismiss notification">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="Transparent" Padding="2">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource Nocturne.Brush.Text}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <controls:NocturneIcon Width="13"
                                     Height="13"
                                     Geometry="{StaticResource Nocturne.Icon.X}" />
            </Button>
          </Grid>

          <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
            <TextBlock x:Name="OldFormatText"
                       Margin="0,0,0,2"
                       VerticalAlignment="Bottom"
                       FontSize="{StaticResource Nocturne.FontSize.Secondary}"
                       Foreground="{StaticResource Nocturne.Brush.Text40}" />
            <controls:NocturneIcon x:Name="TransitionArrow"
                                   Width="11"
                                   Height="11"
                                   Margin="8,0,8,5"
                                   VerticalAlignment="Bottom"
                                   Foreground="{StaticResource Nocturne.Brush.Accent}"
                                   Geometry="{StaticResource Nocturne.Icon.ArrowRight}" />
            <TextBlock x:Name="NewFormatText"
                       VerticalAlignment="Bottom"
                       FontSize="{StaticResource Nocturne.FontSize.ReadoutSmall}"
                       FontWeight="Medium"
                       Foreground="{StaticResource Nocturne.Brush.AccentLight}" />
          </StackPanel>

          <TextBlock x:Name="TrackLineText"
                     Margin="0,5,0,0"
                     FontSize="{StaticResource Nocturne.FontSize.Secondary}"
                     Foreground="{StaticResource Nocturne.Brush.Text65}"
                     TextTrimming="CharacterEllipsis"
                     Visibility="Collapsed" />
          <TextBlock x:Name="DeviceLineText"
                     Margin="0,3,0,0"
                     FontSize="{StaticResource Nocturne.FontSize.Faint}"
                     Foreground="{StaticResource Nocturne.Brush.Text35}"
                     TextTrimming="CharacterEllipsis"
                     Visibility="Collapsed" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 1d minimal pill -->
    <Border x:Name="PillRoot"
            Background="{StaticResource Nocturne.Brush.Surface}"
            BorderBrush="{StaticResource Nocturne.Brush.MidRing}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="9,9,16,9"
            SnapsToDevicePixels="True"
            Visibility="Collapsed">
      <Border.Effect>
        <DropShadowEffect BlurRadius="28"
                          Direction="270"
                          Opacity="0.55"
                          ShadowDepth="7"
                          Color="#FF000000" />
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <Border Width="38"
                Height="38"
                CornerRadius="5">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Offset="0" Color="#FF423A6A" />
              <GradientStop Offset="1" Color="#FF1B1D2B" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <controls:NocturneIcon Width="15"
                                   Height="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Nocturne.Brush.White55}"
                                   Geometry="{StaticResource Nocturne.Icon.MusicNotes}" />
            <Border x:Name="PillArtworkHost"
                    CornerRadius="5"
                    Visibility="Collapsed">
              <Border.Background>
                <ImageBrush x:Name="PillArtworkBrush" Stretch="UniformToFill" />
              </Border.Background>
            </Border>
          </Grid>
        </Border>
        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="PillRateText"
                     FontSize="16"
                     FontWeight="Medium"
                     Foreground="{StaticResource Nocturne.Brush.AccentLight}" />
          <TextBlock x:Name="PillBitsText"
                     FontSize="{StaticResource Nocturne.FontSize.Kicker}"
                     Foreground="{StaticResource Nocturne.Brush.Text40}" />
        </StackPanel>
        <Ellipse Width="6"
                 Height="6"
                 Margin="11,0,0,0"
                 VerticalAlignment="Center"
                 Fill="{StaticResource Nocturne.Brush.Accent}" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
