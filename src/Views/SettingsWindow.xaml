<controls:NocturneWindow
  x:Class="WindowsLosslessSwitcher.Views.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:WindowsLosslessSwitcher.Controls"
  xmlns:pages="clr-namespace:WindowsLosslessSwitcher.Views.SettingsPages"
  Title="Windows Lossless Switcher — Settings"
  Width="920"
  Height="720"
  MinWidth="760"
  MinHeight="480"
  Background="{DynamicResource Nocturne.Brush.Ground}"
  FontFamily="{StaticResource Nocturne.FontFamily}"
  Foreground="{DynamicResource Nocturne.Brush.Text}"
  ResizeMode="CanResize"
  ShowInTaskbar="True"
  TextOptions.TextFormattingMode="Display"
  WindowStartupLocation="CenterScreen">
  <Border
    BorderBrush="{DynamicResource Nocturne.Brush.Ring}"
    BorderThickness="1"
    Background="{DynamicResource Nocturne.Brush.Ground}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition
          Height="42" />
        <RowDefinition
          Height="*" />
      </Grid.RowDefinitions>
      <!-- Nav rail -->
      <!-- Content column -->
      <Grid
        Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition
            Width="208" />
          <ColumnDefinition
            Width="*" />
        </Grid.ColumnDefinitions>
        <Border
          Grid.Column="0"
          BorderBrush="{DynamicResource Nocturne.Brush.Hairline08}"
          BorderThickness="0,0,1,0"
          Padding="12,20">
          <DockPanel>
            <StackPanel
              Margin="4,0"
              DockPanel.Dock="Top"
              Orientation="Horizontal">
              <Border
                Width="30"
                Height="30"
                Background="{DynamicResource Nocturne.Brush.AccentTint}"
                BorderBrush="{DynamicResource Nocturne.Brush.AccentDeep}"
                BorderThickness="1"
                CornerRadius="8">
                <controls:MiniSpectrograph
                  x:Name="NavTileSpectrograph"
                  Width="16"
                  Height="16" />
              </Border>
              <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center">
                <TextBlock
                  FontSize="{StaticResource Nocturne.FontSize.Body}"
                  FontWeight="SemiBold"
                  Text="Lossless Switcher" />
                <TextBlock
                  FontSize="{StaticResource Nocturne.FontSize.Kicker}"
                  Foreground="{DynamicResource Nocturne.Brush.Text40}"
                  Text="for Apple Music" />
              </StackPanel>
            </StackPanel>
            <StackPanel
              Margin="4,0"
              DockPanel.Dock="Bottom">
              <TextBlock
                FontSize="{StaticResource Nocturne.FontSize.Small}"
                Foreground="{DynamicResource Nocturne.Brush.Text40}"
                Text="{Binding AppVersionText}" />
              <StackPanel
                Margin="0,3,0,0"
                Orientation="Horizontal">
                <Ellipse
                  Width="5"
                  Height="5"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource Nocturne.Brush.Accent}" />
                <TextBlock
                  Margin="6,0,0,0"
                  VerticalAlignment="Center"
                  FontSize="{StaticResource Nocturne.FontSize.Small}"
                  Foreground="{DynamicResource Nocturne.Brush.Text55}"
                  Text="{Binding UpdateBadgeText}" />
              </StackPanel>
            </StackPanel>
            <ListBox
              x:Name="NavList"
              Margin="0,22,0,0"
              SelectionChanged="NavList_OnSelectionChanged"
              Style="{StaticResource Nocturne.NavList}"
              AutomationProperties.Name="Settings navigation">
              <ListBoxItem
                AutomationProperties.Name="Status">
                <StackPanel
                  Orientation="Horizontal">
                  <controls:NocturneIcon
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Geometry="{StaticResource Nocturne.Icon.Pulse}" />
                  <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="Status" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem
                AutomationProperties.Name="Switching">
                <StackPanel
                  Orientation="Horizontal">
                  <controls:NocturneIcon
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Geometry="{StaticResource Nocturne.Icon.Faders}" />
                  <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="Switching" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem
                AutomationProperties.Name="Notifications">
                <StackPanel
                  Orientation="Horizontal">
                  <controls:NocturneIcon
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Geometry="{StaticResource Nocturne.Icon.Bell}" />
                  <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="Notifications" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem
                AutomationProperties.Name="Catalog cache">
                <StackPanel
                  Orientation="Horizontal">
                  <controls:NocturneIcon
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Geometry="{StaticResource Nocturne.Icon.Database}" />
                  <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="Cache" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem
                AutomationProperties.Name="Updates">
                <StackPanel
                  Orientation="Horizontal">
                  <controls:NocturneIcon
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Geometry="{StaticResource Nocturne.Icon.ArrowCircleUp}" />
                  <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Text="Updates" />
                </StackPanel>
              </ListBoxItem>
            </ListBox>
          </DockPanel>
        </Border>
        <Grid
          Grid.Column="1">
          <ScrollViewer
            Padding="24,16,24,24"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            KeyboardNavigation.TabNavigation="Continue">
            <Grid
              Margin="0,0,0,26">
              <pages:StatusPage
                x:Name="StatusPage" />
              <pages:SwitchingPage
                x:Name="SwitchingPage"
                Visibility="Collapsed" />
              <pages:NotificationsPage
                x:Name="NotificationsPage"
                Visibility="Collapsed" />
              <pages:CachePage
                x:Name="CachePage"
                Visibility="Collapsed" />
              <pages:UpdatesPage
                x:Name="UpdatesPage"
                Visibility="Collapsed" />
            </Grid>
          </ScrollViewer>
        </Grid>
      </Grid>
      <Grid>
        <TextBlock
          FontSize="{StaticResource Nocturne.FontSize.Body}"
          Margin="20,0,150,0"
          TextWrapping="NoWrap"
          Text="Settings"
          VerticalAlignment="Center" />
        <StackPanel
          Margin="0"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Orientation="Horizontal"
          WindowChrome.IsHitTestVisibleInChrome="True">
          <Button
            Click="MinimizeButton_OnClick"
            Style="{StaticResource Nocturne.CaptionButton}"
            AutomationProperties.Name="Minimize"
            ToolTip="Minimize">
            <controls:NocturneIcon
              Width="13"
              Height="13"
              Geometry="{StaticResource Nocturne.Icon.Minus}" />
          </Button>
          <Button
            AutomationProperties.Name="Maximize or restore window"
            Style="{StaticResource Nocturne.CaptionButton}"
            Click="MaximizeRestoreButton_OnClick"
            ToolTip="Maximize or restore window">
            <TextBlock
              FontSize="12"
              Text=""
              FontFamily="Segoe MDL2 Assets" />
          </Button>
          <Button
            Click="CloseButton_OnClick"
            Style="{StaticResource Nocturne.CaptionButton.Close}"
            AutomationProperties.Name="Close window"
            ToolTip="Close window">
            <controls:NocturneIcon
              Width="13"
              Height="13"
              Geometry="{StaticResource Nocturne.Icon.X}" />
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</controls:NocturneWindow>
