<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Windows system typography; Segoe UI provides the Windows 10 fallback. -->
  <FontFamily
    x:Key="Nocturne.FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily
    x:Key="Nocturne.FontFamily.Mono">Cascadia Mono, Consolas</FontFamily>
  <sys:Double
    x:Key="Nocturne.FontSize.Kicker">12</sys:Double>
  <sys:Double
    x:Key="Nocturne.FontSize.Faint">12</sys:Double>
  <sys:Double
    x:Key="Nocturne.FontSize.Small">12</sys:Double>
  <sys:Double
    x:Key="Nocturne.FontSize.Note">12</sys:Double>
  <sys:Double
    x:Key="Nocturne.FontSize.Secondary">12</sys:Double>
  <sys:Double
    x:Key="Nocturne.FontSize.Control">14</sys:Double>
  <sys:Double
    x:Key="Nocturne.FontSize.Body">14</sys:Double>
  <sys:Double
    x:Key="Nocturne.FontSize.CardTitle">16</sys:Double>
  <sys:Double
    x:Key="Nocturne.FontSize.Heading">20</sys:Double>
  <sys:Double
    x:Key="Nocturne.FontSize.ReadoutSmall">18</sys:Double>
  <sys:Double
    x:Key="Nocturne.FontSize.HeroTitle">20</sys:Double>
  <sys:Double
    x:Key="Nocturne.FontSize.Readout">20</sys:Double>
  <sys:Double
    x:Key="Nocturne.FontSize.ReadoutHero">28</sys:Double>
</ResourceDictionary>