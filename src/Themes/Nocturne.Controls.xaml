        <ControlTemplate
          TargetType="ToolTip">
          <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{DynamicResource Nocturne.Brush.MidRing}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="{TemplateBinding Padding}"
            SnapsToDevicePixels="True">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
