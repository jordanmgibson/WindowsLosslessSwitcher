<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:WindowsLosslessSwitcher.Controls">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary
      Source="/Themes/Nocturne.Colors.xaml" />
    <ResourceDictionary
      Source="/Themes/Nocturne.Typography.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <!-- ═══ Focus ═══ -->
  <Style
    x:Key="Nocturne.FocusVisual">
    <Setter
      Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle
            Margin="-4"
            RadiusX="6"
            RadiusY="6"
            SnapsToDevicePixels="True"
            Stroke="{DynamicResource Nocturne.Brush.Accent}"
            StrokeThickness="2" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style
    TargetType="TextBlock">
    <Setter
      Property="FontSize"
      Value="{StaticResource Nocturne.FontSize.Body}" />
    <Style.Triggers>
      <Trigger Property="FontSize" Value="12"><Setter Property="LineHeight" Value="16" /></Trigger>
      <Trigger Property="FontSize" Value="14"><Setter Property="LineHeight" Value="20" /></Trigger>
      <Trigger Property="FontSize" Value="20"><Setter Property="LineHeight" Value="28" /></Trigger>
      <Trigger Property="FontSize" Value="28"><Setter Property="LineHeight" Value="36" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style
    TargetType="controls:SettingsRow">
    <Setter
      Property="Margin"
      Value="0,8" />
    <Setter
      Property="MinHeight"
      Value="44" />
    <Setter
      Property="HorizontalContentAlignment"
      Value="Stretch" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="controls:SettingsRow">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                Width="*" />
              <ColumnDefinition
                Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
              VerticalAlignment="Center"
              Margin="0,0,20,0">
              <TextBlock
                Text="{TemplateBinding Header}"
                FontSize="{StaticResource Nocturne.FontSize.Body}"
                TextWrapping="Wrap" />
              <TextBlock
                Margin="0,4,0,0"
                Text="{TemplateBinding Description}"
                FontSize="{StaticResource Nocturne.FontSize.Small}"
                Foreground="{DynamicResource Nocturne.Brush.Text55}"
                TextWrapping="Wrap" />
            </StackPanel>
            <ContentPresenter
              Grid.Column="1"
              VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style
    x:Key="Nocturne.SettingsGroup"
    TargetType="Border">
    <Setter
      Property="Margin"
      Value="0,12,0,12" />
    <Setter
      Property="Padding"
      Value="16" />
    <Setter
      Property="CornerRadius"
      Value="8" />
    <Setter
      Property="Background"
      Value="{DynamicResource Nocturne.Brush.Surface}" />
    <Setter
      Property="BorderBrush"
      Value="{DynamicResource Nocturne.Brush.Ring}" />
    <Setter
      Property="BorderThickness"
      Value="1" />
  </Style>
  <Style
    TargetType="ComboBoxItem">
    <Setter
      Property="Padding"
      Value="12,8" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource Nocturne.Brush.Text}" />
    <Setter
      Property="Background"
      Value="{DynamicResource Nocturne.Brush.Recessed}" />
    <Style.Triggers>
      <Trigger
        Property="IsHighlighted"
        Value="True">
        <Setter
          Property="Background"
          Value="{DynamicResource Nocturne.Brush.AccentTint}" />
      </Trigger>
      <Trigger
        Property="IsSelected"
        Value="True">
        <Setter
          Property="FontWeight"
          Value="SemiBold" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource Nocturne.Brush.Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton x:Name="HeaderSite" HorizontalAlignment="Left" Style="{DynamicResource Nocturne.Disclosure}"
                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <StackPanel Orientation="Horizontal">
                <Path x:Name="Caret" Data="M 0,0 L 4,4 L 8,0" Width="8" Height="4" Stretch="Fill" Margin="0,0,10,0" VerticalAlignment="Center"
                      Stroke="{DynamicResource Nocturne.Brush.Text}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5" />
                <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" />
              </StackPanel>
            </ToggleButton>
            <ContentPresenter x:Name="ExpandSite" Content="{TemplateBinding Content}" Visibility="Collapsed" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
              <Setter TargetName="Caret" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style
    TargetType="ComboBox">
    <Setter
      Property="MinHeight"
      Value="36" />
    <Setter
      Property="FontSize"
      Value="{StaticResource Nocturne.FontSize.Body}" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource Nocturne.Brush.Text}" />
    <Setter
      Property="FocusVisualStyle"
      Value="{StaticResource Nocturne.FocusVisual}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="ComboBox">
          <Grid>
            <ToggleButton
              Focusable="False"
              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate
                  TargetType="ToggleButton">
                  <Border
                    x:Name="Field"
                    Background="{DynamicResource Nocturne.Brush.Recessed}"
                    BorderBrush="{DynamicResource Nocturne.Brush.MidRing}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Path
                      Data="M 0,0 L 4,4 L 8,0"
                      Width="8"
                      Height="4"
                      Stretch="Fill"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0"
                      StrokeThickness="1.5"
                      Stroke="{DynamicResource Nocturne.Brush.Text}" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger
                      Property="IsMouseOver"
                      Value="True">
                      <Setter
                        TargetName="Field"
                        Property="BorderBrush"
                        Value="{DynamicResource Nocturne.Brush.Accent}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter
              Margin="12,7,36,7"
              VerticalAlignment="Center"
              IsHitTestVisible="False"
              Content="{TemplateBinding SelectionBoxItem}"
              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
            <Popup
              x:Name="PART_Popup"
              Placement="Bottom"
              IsOpen="{TemplateBinding IsDropDownOpen}"
              AllowsTransparency="True"
              Focusable="False">
              <Border
                Margin="0,4,0,0"
                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                MaxHeight="320"
                Background="{DynamicResource Nocturne.Brush.Recessed}"
                BorderBrush="{DynamicResource Nocturne.Brush.MidRing}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="2">
                <ScrollViewer
                  CanContentScroll="True"
                  VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter
                    KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsEnabled"
              Value="False">
              <Setter
                Property="Opacity"
                Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- ═══ Text helpers ═══ -->
  <Style
    x:Key="Nocturne.Kicker"
    TargetType="TextBlock">
    <Setter
      Property="FontSize"
      Value="{StaticResource Nocturne.FontSize.Kicker}" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource Nocturne.Brush.Text40}" />
  </Style>
  <!-- ═══ Buttons ═══ -->
  <Style
    x:Key="Nocturne.Button.Primary"
    TargetType="Button">
    <Setter
      Property="MinHeight"
      Value="32" />
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="BorderBrush"
      Value="{DynamicResource Nocturne.Brush.Accent}" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource Nocturne.Brush.AccentLight}" />
    <Setter
      Property="FontSize"
      Value="{StaticResource Nocturne.FontSize.Control}" />
    <Setter
      Property="FontWeight"
      Value="Medium" />
    <Setter
      Property="Padding"
      Value="14,7" />
    <Setter
      Property="Cursor"
      Value="Hand" />
    <Setter
      Property="FocusVisualStyle"
      Value="{StaticResource Nocturne.FocusVisual}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="Button">
          <Border
            x:Name="Bg"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="{TemplateBinding Padding}"
            SnapsToDevicePixels="True">
            <ContentPresenter
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                TargetName="Bg"
                Property="Background"
                Value="{DynamicResource Nocturne.Brush.AccentHoverFill}" />
            </Trigger>
            <Trigger
              Property="IsEnabled"
              Value="False">
              <Setter
                Property="Opacity"
                Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style
    x:Key="Nocturne.Button.Ghost"
    TargetType="Button">
    <Setter
      Property="MinHeight"
      Value="32" />
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="BorderBrush"
      Value="{DynamicResource Nocturne.Brush.Hairline16}" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource Nocturne.Brush.Text70}" />
    <Setter
      Property="FontSize"
      Value="{StaticResource Nocturne.FontSize.Control}" />
    <Setter
      Property="Padding"
      Value="12,7" />
    <Setter
      Property="Cursor"
      Value="Hand" />
    <Setter
      Property="FocusVisualStyle"
      Value="{StaticResource Nocturne.FocusVisual}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="Button">
          <Border
            x:Name="Bg"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="{TemplateBinding Padding}"
            SnapsToDevicePixels="True">
            <ContentPresenter
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                TargetName="Bg"
                Property="BorderBrush"
                Value="{DynamicResource Nocturne.Brush.MidRing}" />
              <Setter
                Property="Foreground"
                Value="{DynamicResource Nocturne.Brush.Text}" />
            </Trigger>
            <Trigger
              Property="IsEnabled"
              Value="False">
              <Setter
                Property="Opacity"
                Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Caption buttons: 36×30, radius 6, 13px glyph at 50% text; close turns #c42b1c. -->
  <Style
    x:Key="Nocturne.CaptionButton"
    TargetType="Button">
    <Setter
      Property="Width"
      Value="46" />
    <Setter
      Property="Height"
      Value="40" />
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource Nocturne.Brush.Text50}" />
    <Setter
      Property="Focusable"
      Value="False" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="Button">
          <Border
            x:Name="Bg"
            Background="{TemplateBinding Background}"
            CornerRadius="6"
            SnapsToDevicePixels="True">
            <ContentPresenter
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                TargetName="Bg"
                Property="Background"
                Value="{DynamicResource Nocturne.Brush.Hover}" />
              <Setter
                Property="Foreground"
                Value="{DynamicResource Nocturne.Brush.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style
    x:Key="Nocturne.CaptionButton.Close"
    TargetType="Button"
    BasedOn="{StaticResource Nocturne.CaptionButton}">
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="Button">
          <Border
            x:Name="Bg"
            Background="{TemplateBinding Background}"
            CornerRadius="6"
            SnapsToDevicePixels="True">
            <ContentPresenter
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                TargetName="Bg"
                Property="Background"
                Value="{DynamicResource Nocturne.Brush.CloseHover}" />
              <Setter
                Property="Foreground"
                Value="{DynamicResource Nocturne.Brush.White}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- ═══ Toggle switch: 34×18 track, 12px knob, 150ms travel ═══ -->
  <Style
    x:Key="Nocturne.ToggleSwitch"
    TargetType="ToggleButton">
    <Setter
      Property="MinWidth"
      Value="44" />
    <Setter
      Property="MinHeight"
      Value="32" />
    <Setter
      Property="Cursor"
      Value="Hand" />
    <Setter
      Property="FocusVisualStyle"
      Value="{StaticResource Nocturne.FocusVisual}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="ToggleButton">
          <Border
            x:Name="Track"
            Width="40"
            Height="20"
            Background="{DynamicResource Nocturne.Brush.Hover}"
            BorderBrush="{DynamicResource Nocturne.Brush.MidRing}"
            BorderThickness="1"
            CornerRadius="10"
            SnapsToDevicePixels="True">
            <Canvas>
              <Ellipse
                x:Name="Knob"
                Canvas.Left="2"
                Canvas.Top="2"
                Width="14"
                Height="14"
                Fill="{DynamicResource Nocturne.Brush.OffKnob}" />
            </Canvas>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsChecked"
              Value="True">
              <Setter
                TargetName="Track"
                Property="Background"
                Value="{DynamicResource Nocturne.Brush.AccentDeep}" />
              <Setter
                TargetName="Track"
                Property="BorderBrush"
                Value="{DynamicResource Nocturne.Brush.Accent}" />
              <Setter
                TargetName="Knob"
                Property="Fill"
                Value="{DynamicResource Nocturne.Brush.AccentLight}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation
                      Storyboard.TargetName="Knob"
                      Storyboard.TargetProperty="(Canvas.Left)"
                      To="22"
                      Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation
                      Storyboard.TargetName="Knob"
                      Storyboard.TargetProperty="(Canvas.Left)"
                      To="2"
                      Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger
              Property="IsEnabled"
              Value="False">
              <Setter
                Property="Opacity"
                Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- ═══ Chips ═══ -->
  <!-- Checkable chip (single- or multi-select). Checked: tint bg, accent ring, readout text. -->
  <Style
    x:Key="Nocturne.Chip.Checkable"
    TargetType="ToggleButton">
    <Setter
      Property="MinHeight"
      Value="32" />
    <Setter
      Property="FontSize"
      Value="{StaticResource Nocturne.FontSize.Note}" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource Nocturne.Brush.Text50}" />
    <Setter
      Property="Cursor"
      Value="Hand" />
    <Setter
      Property="FocusVisualStyle"
      Value="{StaticResource Nocturne.FocusVisual}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="ToggleButton">
          <Border
            x:Name="Bg"
            Background="{DynamicResource Nocturne.Brush.Hover}"
            BorderBrush="{DynamicResource Nocturne.Brush.Ring}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="9,3"
            SnapsToDevicePixels="True">
            <ContentPresenter
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsChecked"
              Value="True">
              <Setter
                TargetName="Bg"
                Property="Background"
                Value="{DynamicResource Nocturne.Brush.AccentTint}" />
              <Setter
                TargetName="Bg"
                Property="BorderBrush"
                Value="{DynamicResource Nocturne.Brush.Accent}" />
              <Setter
                Property="Foreground"
                Value="{DynamicResource Nocturne.Brush.AccentLight}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Allow-list chip: same, but unchecked entries dim to 55%. -->
  <Style
    x:Key="Nocturne.Chip.Allowed"
    TargetType="ToggleButton"
    BasedOn="{StaticResource Nocturne.Chip.Checkable}">
    <Style.Triggers>
      <Trigger
        Property="IsChecked"
        Value="False">
        <Setter
          Property="Opacity"
          Value="1" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- ═══ Segmented control option (host: Border padding 3, radius 8, recessed, ring hover) ═══ -->
  <Style
    x:Key="Nocturne.SegmentedOption"
    TargetType="RadioButton">
    <Setter
      Property="MinHeight"
      Value="32" />
    <Setter
      Property="FontSize"
      Value="{StaticResource Nocturne.FontSize.Control}" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource Nocturne.Brush.Text55}" />
    <Setter
      Property="Cursor"
      Value="Hand" />
    <Setter
      Property="FocusVisualStyle"
      Value="{StaticResource Nocturne.FocusVisual}" />
    <Setter
      Property="Margin"
      Value="0,0,2,0" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="RadioButton">
          <Border
            x:Name="Bg"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            CornerRadius="7"
            Padding="12,5"
            SnapsToDevicePixels="True">
            <ContentPresenter
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsChecked"
              Value="True">
              <Setter
                TargetName="Bg"
                Property="Background"
                Value="{DynamicResource Nocturne.Brush.AccentTint}" />
              <Setter
                TargetName="Bg"
                Property="BorderBrush"
                Value="{DynamicResource Nocturne.Brush.Accent}" />
              <Setter
                Property="Foreground"
                Value="{DynamicResource Nocturne.Brush.AccentLight}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- ═══ TextBox with focus glow ═══ -->
  <Style
    x:Key="Nocturne.TextBox"
    TargetType="TextBox">
    <Setter
      Property="Background"
      Value="{DynamicResource Nocturne.Brush.Recessed}" />
    <Setter
      Property="BorderBrush"
      Value="{DynamicResource Nocturne.Brush.Ring}" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource Nocturne.Brush.Text}" />
    <Setter
      Property="CaretBrush"
      Value="{DynamicResource Nocturne.Brush.Text}" />
    <Setter
      Property="SelectionBrush"
      Value="{DynamicResource Nocturne.Brush.Accent}" />
    <Setter
      Property="FontSize"
      Value="{StaticResource Nocturne.FontSize.Control}" />
    <Setter
      Property="Padding"
      Value="10,6" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="TextBox">
          <Border
            x:Name="Glow"
            BorderBrush="Transparent"
            BorderThickness="2"
            CornerRadius="9">
            <Border
              x:Name="Bg"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="1"
              CornerRadius="7"
              Padding="{TemplateBinding Padding}"
              SnapsToDevicePixels="True">
              <ScrollViewer
                x:Name="PART_ContentHost"
                Margin="0"
                VerticalAlignment="Center"
                Focusable="False"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Hidden" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsKeyboardFocusWithin"
              Value="True">
              <Setter
                TargetName="Bg"
                Property="BorderBrush"
                Value="{DynamicResource Nocturne.Brush.Accent}" />
              <Setter
                TargetName="Glow"
                Property="BorderBrush"
                Value="{DynamicResource Nocturne.Brush.FocusGlow}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- ═══ Nav rail ═══ -->
  <Style
    x:Key="Nocturne.NavItem"
    TargetType="ListBoxItem">
    <Setter
      Property="Foreground"
      Value="{DynamicResource Nocturne.Brush.Text55}" />
    <Setter
      Property="FontSize"
      Value="{StaticResource Nocturne.FontSize.Body}" />
    <Setter
      Property="Cursor"
      Value="Hand" />
    <Setter
      Property="Margin"
      Value="0,0,0,2" />
    <Setter
      Property="FocusVisualStyle"
      Value="{StaticResource Nocturne.FocusVisual}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="ListBoxItem">
          <Border
            x:Name="Bg"
            Background="Transparent"
            CornerRadius="8"
            SnapsToDevicePixels="True">
            <Grid>
              <Rectangle
                x:Name="AccentBar"
                Width="2"
                Margin="0,3"
                HorizontalAlignment="Left"
                Fill="{DynamicResource Nocturne.Brush.Accent}"
                Visibility="Collapsed" />
              <ContentPresenter
                Margin="10,8" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsSelected"
              Value="True">
              <Setter
                TargetName="Bg"
                Property="Background"
                Value="{DynamicResource Nocturne.Brush.AccentTint}" />
              <Setter
                TargetName="AccentBar"
                Property="Visibility"
                Value="Visible" />
              <Setter
                Property="Foreground"
                Value="{DynamicResource Nocturne.Brush.AccentLight}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition
                  Property="IsMouseOver"
                  Value="True" />
                <Condition
                  Property="IsSelected"
                  Value="False" />
              </MultiTrigger.Conditions>
              <Setter
                Property="Foreground"
                Value="{DynamicResource Nocturne.Brush.Text}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style
    x:Key="Nocturne.NavList"
    TargetType="ListBox">
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="BorderThickness"
      Value="0" />
    <Setter
      Property="Padding"
      Value="0" />
    <Setter
      Property="ItemContainerStyle"
      Value="{StaticResource Nocturne.NavItem}" />
    <Setter
      Property="ScrollViewer.HorizontalScrollBarVisibility"
      Value="Disabled" />
    <Setter
      Property="ScrollViewer.VerticalScrollBarVisibility"
      Value="Disabled" />
    <Setter
      Property="KeyboardNavigation.DirectionalNavigation"
      Value="Cycle" />
  </Style>
  <!-- ═══ Pinned-device rows ═══ -->
  <Style
    x:Key="Nocturne.DeviceRow"
    TargetType="ListBoxItem">
    <Setter
      Property="Foreground"
      Value="{DynamicResource Nocturne.Brush.Text60}" />
    <Setter
      Property="Cursor"
      Value="Hand" />
    <Setter
      Property="Margin"
      Value="0,0,0,6" />
    <Setter
      Property="FocusVisualStyle"
      Value="{StaticResource Nocturne.FocusVisual}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="ListBoxItem">
          <Border
            x:Name="Bg"
            Background="Transparent"
            BorderBrush="{DynamicResource Nocturne.Brush.Ring}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,9"
            SnapsToDevicePixels="True">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsSelected"
              Value="True">
              <Setter
                TargetName="Bg"
                Property="Background"
                Value="{DynamicResource Nocturne.Brush.Surface}" />
              <Setter
                TargetName="Bg"
                Property="BorderBrush"
                Value="{DynamicResource Nocturne.Brush.Accent}" />
              <Setter
                Property="Foreground"
                Value="{DynamicResource Nocturne.Brush.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style
    x:Key="Nocturne.DeviceList"
    TargetType="ListBox">
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="BorderThickness"
      Value="0" />
    <Setter
      Property="Padding"
      Value="0" />
    <Setter
      Property="ItemContainerStyle"
      Value="{StaticResource Nocturne.DeviceRow}" />
    <Setter
      Property="ScrollViewer.HorizontalScrollBarVisibility"
      Value="Disabled" />
  </Style>
  <!-- ═══ Flyout / menu row ═══ -->
  <Style
    x:Key="Nocturne.MenuRow"
    TargetType="Button">
    <Setter
      Property="MinHeight"
      Value="32" />
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource Nocturne.Brush.Text80}" />
    <Setter
      Property="FontSize"
      Value="{StaticResource Nocturne.FontSize.Control}" />
    <Setter
      Property="Cursor"
      Value="Hand" />
    <Setter
      Property="HorizontalContentAlignment"
      Value="Left" />
    <Setter
      Property="FocusVisualStyle"
      Value="{StaticResource Nocturne.FocusVisual}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="Button">
          <Border
            x:Name="Bg"
            Background="{TemplateBinding Background}"
            CornerRadius="7"
            Padding="10,7"
            SnapsToDevicePixels="True">
            <ContentPresenter
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                TargetName="Bg"
                Property="Background"
                Value="{DynamicResource Nocturne.Brush.Hover}" />
              <Setter
                Property="Foreground"
                Value="{DynamicResource Nocturne.Brush.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- ═══ Details disclosure ═══ -->
  <Style
    x:Key="Nocturne.Disclosure"
    TargetType="ToggleButton">
    <Setter
      Property="MinHeight"
      Value="32" />
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="Foreground"
      Value="{DynamicResource Nocturne.Brush.Text45}" />
    <Setter
      Property="FontSize"
      Value="{StaticResource Nocturne.FontSize.Note}" />
    <Setter
      Property="Cursor"
      Value="Hand" />
    <Setter
      Property="FocusVisualStyle"
      Value="{StaticResource Nocturne.FocusVisual}" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="ToggleButton">
          <Border
            Background="Transparent"
            Padding="2">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                Property="Foreground"
                Value="{DynamicResource Nocturne.Brush.AccentLight}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- ═══ Status dot: settled accent, pulsing accent-pulse while busy ═══
       Expects the shared MainWindowViewModel as DataContext (IsBusyPhase). -->
  <Style
    x:Key="Nocturne.StatusDot"
    TargetType="Ellipse">
    <Setter
      Property="Width"
      Value="6" />
    <Setter
      Property="Height"
      Value="6" />
    <Setter
      Property="Fill"
      Value="{DynamicResource Nocturne.Brush.Accent}" />
    <Style.Triggers>
      <DataTrigger
        Binding="{Binding IsBusyPhase}"
        Value="True">
        <Setter
          Property="Fill"
          Value="{DynamicResource Nocturne.Brush.AccentPulse}" />
        <DataTrigger.EnterActions>
          <BeginStoryboard
            x:Name="NocturnePulse">
            <Storyboard
              RepeatBehavior="Forever">
              <DoubleAnimationUsingKeyFrames
                Duration="0:0:1"
                Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame
                  KeyTime="0:0:0"
                  Value="1" />
                <EasingDoubleKeyFrame
                  KeyTime="0:0:0.5"
                  Value="0.35">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <SineEase
                      EasingMode="EaseInOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame
                  KeyTime="0:0:1"
                  Value="1">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <SineEase
                      EasingMode="EaseInOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <StopStoryboard
            BeginStoryboardName="NocturnePulse" />
        </DataTrigger.ExitActions>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <!-- ═══ Fading dividers ═══ -->
  <Style
    x:Key="Nocturne.Divider"
    TargetType="Control">
    <Setter
      Property="Height"
      Value="1" />
    <Setter
      Property="IsTabStop"
      Value="False" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="Control">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                Width="48" />
              <ColumnDefinition
                Width="*" />
              <ColumnDefinition
                Width="48" />
            </Grid.ColumnDefinitions>
            <Border
              Grid.Column="0"
              Background="{DynamicResource Nocturne.Brush.DividerCapLeft}" />
            <Border
              Grid.Column="1"
              Background="{DynamicResource Nocturne.Brush.Hairline16}" />
            <Border
              Grid.Column="2"
              Background="{DynamicResource Nocturne.Brush.DividerCapRight}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style
    x:Key="Nocturne.Divider.Tray"
    TargetType="Control">
    <Setter
      Property="Height"
      Value="1" />
    <Setter
      Property="IsTabStop"
      Value="False" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="Control">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                Width="40" />
              <ColumnDefinition
                Width="*" />
              <ColumnDefinition
                Width="40" />
            </Grid.ColumnDefinitions>
            <Border
              Grid.Column="0"
              Background="{DynamicResource Nocturne.Brush.DividerCapLeft14}" />
            <Border
              Grid.Column="1"
              Background="{DynamicResource Nocturne.Brush.Hairline14}" />
            <Border
              Grid.Column="2"
              Background="{DynamicResource Nocturne.Brush.DividerCapRight14}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- ═══ Scrollbars (implicit: slim dark thumb, no buttons) ═══ -->
  <Style
    x:Key="Nocturne.ScrollBar.TrackButton"
    TargetType="RepeatButton">
    <Setter
      Property="Focusable"
      Value="False" />
    <Setter
      Property="IsTabStop"
      Value="False" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="RepeatButton">
          <Border
            Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style
    x:Key="Nocturne.ScrollBar.Thumb"
    TargetType="Thumb">
    <Setter
      Property="IsTabStop"
      Value="False" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="Thumb">
          <Border
            x:Name="Bg"
            Background="{DynamicResource Nocturne.Brush.Ring}"
            CornerRadius="4" />
          <ControlTemplate.Triggers>
            <Trigger
              Property="IsMouseOver"
              Value="True">
              <Setter
                TargetName="Bg"
                Property="Background"
                Value="{DynamicResource Nocturne.Brush.MidRing}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style
    TargetType="ScrollBar">
    <Setter
      Property="Background"
      Value="Transparent" />
    <Setter
      Property="Width"
      Value="8" />
    <Setter
      Property="Template">
      <Setter.Value>
        <ControlTemplate
          TargetType="ScrollBar">
          <Grid
            Background="Transparent">
            <Track
              x:Name="PART_Track"
              IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton
                  Command="ScrollBar.PageUpCommand"
                  Style="{StaticResource Nocturne.ScrollBar.TrackButton}" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton
                  Command="ScrollBar.PageDownCommand"
                  Style="{StaticResource Nocturne.ScrollBar.TrackButton}" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb
                  Style="{StaticResource Nocturne.ScrollBar.Thumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger
        Property="Orientation"
        Value="Horizontal">
        <Setter
          Property="Width"
          Value="Auto" />
        <Setter
          Property="Height"
          Value="8" />
        <Setter
          Property="Template">
          <Setter.Value>
            <ControlTemplate
              TargetType="ScrollBar">
              <Grid
                Background="Transparent">
                <Track
                  x:Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton
                      Command="ScrollBar.PageLeftCommand"
                      Style="{StaticResource Nocturne.ScrollBar.TrackButton}" />
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton
                      Command="ScrollBar.PageRightCommand"
                      Style="{StaticResource Nocturne.ScrollBar.TrackButton}" />
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb
                      Style="{StaticResource Nocturne.ScrollBar.Thumb}" />
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- ═══ ToolTip (implicit) ═══ -->
  <Style
