<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Nocturne design tokens. Accent is used for rings, outlines, icons, and dots only — never
       as a surface fill; readouts and active-state text use AccentLight. No pure black or white. -->

  <Color x:Key="Nocturne.Color.Ground">#FF161826</Color>
  <Color x:Key="Nocturne.Color.Surface">#FF232532</Color>
  <Color x:Key="Nocturne.Color.Recessed">#FF1B1D2B</Color>
  <Color x:Key="Nocturne.Color.Accent">#FF9184D9</Color>
  <Color x:Key="Nocturne.Color.AccentLight">#FFD2CEFD</Color>
  <Color x:Key="Nocturne.Color.AccentPulse">#FFB5ABFC</Color>
  <Color x:Key="Nocturne.Color.AccentTint">#FF2B2741</Color>
  <Color x:Key="Nocturne.Color.AccentDeep">#FF423A6A</Color>
  <Color x:Key="Nocturne.Color.Ring">#FF3F424D</Color>
  <Color x:Key="Nocturne.Color.MidRing">#FF595D6C</Color>
  <Color x:Key="Nocturne.Color.Hover">#FF292B31</Color>
  <Color x:Key="Nocturne.Color.Text">#FFE9E9ED</Color>
  <Color x:Key="Nocturne.Color.CloseHover">#FFC42B1C</Color>

  <SolidColorBrush x:Key="Nocturne.Brush.Ground" Color="#FF161826" />
  <SolidColorBrush x:Key="Nocturne.Brush.Surface" Color="#FF232532" />
  <SolidColorBrush x:Key="Nocturne.Brush.Recessed" Color="#FF1B1D2B" />
  <SolidColorBrush x:Key="Nocturne.Brush.Accent" Color="#FF9184D9" />
  <SolidColorBrush x:Key="Nocturne.Brush.AccentLight" Color="#FFD2CEFD" />
  <SolidColorBrush x:Key="Nocturne.Brush.AccentPulse" Color="#FFB5ABFC" />
  <SolidColorBrush x:Key="Nocturne.Brush.AccentTint" Color="#FF2B2741" />
  <SolidColorBrush x:Key="Nocturne.Brush.AccentDeep" Color="#FF423A6A" />
  <SolidColorBrush x:Key="Nocturne.Brush.Ring" Color="#FF3F424D" />
  <SolidColorBrush x:Key="Nocturne.Brush.MidRing" Color="#FF595D6C" />
  <SolidColorBrush x:Key="Nocturne.Brush.Hover" Color="#FF292B31" />
  <SolidColorBrush x:Key="Nocturne.Brush.Muted" Color="#FF9397AB" />
  <SolidColorBrush x:Key="Nocturne.Brush.OffKnob" Color="#FF75798C" />
  <SolidColorBrush x:Key="Nocturne.Brush.CloseHover" Color="#FFC42B1C" />
  <SolidColorBrush x:Key="Nocturne.Brush.White" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Nocturne.Brush.White55" Color="#8CFFFFFF" />

  <!-- Text opacity ladder on #E9E9ED -->
  <SolidColorBrush x:Key="Nocturne.Brush.Text" Color="#FFE9E9ED" />
  <SolidColorBrush x:Key="Nocturne.Brush.Text80" Color="#CCE9E9ED" />
  <SolidColorBrush x:Key="Nocturne.Brush.Text75" Color="#BFE9E9ED" />
  <SolidColorBrush x:Key="Nocturne.Brush.Text70" Color="#B3E9E9ED" />
  <SolidColorBrush x:Key="Nocturne.Brush.Text65" Color="#A6E9E9ED" />
  <SolidColorBrush x:Key="Nocturne.Brush.Text60" Color="#99E9E9ED" />
  <SolidColorBrush x:Key="Nocturne.Brush.Text55" Color="#8CE9E9ED" />
  <SolidColorBrush x:Key="Nocturne.Brush.Text50" Color="#80E9E9ED" />
  <SolidColorBrush x:Key="Nocturne.Brush.Text45" Color="#73E9E9ED" />
  <SolidColorBrush x:Key="Nocturne.Brush.Text40" Color="#66E9E9ED" />
  <SolidColorBrush x:Key="Nocturne.Brush.Text35" Color="#59E9E9ED" />
  <SolidColorBrush x:Key="Nocturne.Brush.Text30" Color="#4DE9E9ED" />

  <!-- Hairlines / faint fills on #E9E9ED -->
  <SolidColorBrush x:Key="Nocturne.Brush.Hairline16" Color="#29E9E9ED" />
  <SolidColorBrush x:Key="Nocturne.Brush.Hairline14" Color="#24E9E9ED" />
  <SolidColorBrush x:Key="Nocturne.Brush.Hairline10" Color="#1AE9E9ED" />
  <SolidColorBrush x:Key="Nocturne.Brush.Hairline08" Color="#14E9E9ED" />
  <SolidColorBrush x:Key="Nocturne.Brush.Hairline06" Color="#0FE9E9ED" />

  <!-- Accent-derived translucent fills -->
  <SolidColorBrush x:Key="Nocturne.Brush.AccentHoverFill" Color="#1F9184D9" />
  <SolidColorBrush x:Key="Nocturne.Brush.FocusGlow" Color="#409184D9" />

  <!-- Fading divider caps (transparent → 16% text) -->
  <LinearGradientBrush x:Key="Nocturne.Brush.DividerCapLeft" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#00E9E9ED" />
    <GradientStop Offset="1" Color="#29E9E9ED" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Nocturne.Brush.DividerCapRight" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#29E9E9ED" />
    <GradientStop Offset="1" Color="#00E9E9ED" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Nocturne.Brush.DividerCapLeft14" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#00E9E9ED" />
    <GradientStop Offset="1" Color="#24E9E9ED" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Nocturne.Brush.DividerCapRight14" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#24E9E9ED" />
    <GradientStop Offset="1" Color="#00E9E9ED" />
  </LinearGradientBrush>

</ResourceDictionary>
