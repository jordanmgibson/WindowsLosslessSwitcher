<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Neutral charcoal surfaces with restrained music-red accents for active controls,
       icons, focus, and tinted states; readouts use the softer AccentLight. -->
  <Color
    x:Key="Nocturne.Color.Ground">#FF1E1E1E</Color>
  <Color
    x:Key="Nocturne.Color.Surface">#FF292929</Color>
  <Color
    x:Key="Nocturne.Color.Recessed">#FF242424</Color>
  <Color
    x:Key="Nocturne.Color.Accent">#FFFF667A</Color>
  <Color
    x:Key="Nocturne.Color.AccentLight">#FFFFE3E7</Color>
  <Color
    x:Key="Nocturne.Color.AccentPulse">#FFFF8A99</Color>
  <Color
    x:Key="Nocturne.Color.AccentTint">#FF35262A</Color>
  <Color
    x:Key="Nocturne.Color.AccentDeep">#FF61323B</Color>
  <Color
    x:Key="Nocturne.Color.Ring">#FF484848</Color>
  <Color
    x:Key="Nocturne.Color.MidRing">#FF626262</Color>
  <Color
    x:Key="Nocturne.Color.Hover">#FF353535</Color>
  <Color
    x:Key="Nocturne.Color.Text">#FFF2F2F2</Color>
  <Color
    x:Key="Nocturne.Color.CloseHover">#FFC42B1C</Color>
  <SolidColorBrush
    x:Key="Nocturne.Brush.Ground"
    Color="#FF1E1E1E" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Surface"
    Color="#FF292929" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Recessed"
    Color="#FF242424" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Accent"
    Color="#FFFF667A" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.AccentLight"
    Color="#FFFFE3E7" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.AccentPulse"
    Color="#FFFF8A99" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.AccentTint"
    Color="#FF35262A" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.AccentDeep"
    Color="#FF61323B" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Ring"
    Color="#FF737373" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.MidRing"
    Color="#FF929292" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Hover"
    Color="#FF353535" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Muted"
    Color="#FFADADAD" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.OffKnob"
    Color="#FF969696" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.CloseHover"
    Color="#FFC42B1C" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.White"
    Color="#FFFFFFFF" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.White55"
    Color="#8CFFFFFF" />
  <!-- Text opacity ladder on #F2F2F2 -->
  <SolidColorBrush
    x:Key="Nocturne.Brush.Text"
    Color="#FFF2F2F2" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Text80"
    Color="#FFDCDCDC" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Text75"
    Color="#FFDCDCDC" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Text70"
    Color="#FFBDBDBD" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Text65"
    Color="#FFBDBDBD" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Text60"
    Color="#FFBDBDBD" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Text55"
    Color="#FFBDBDBD" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Text50"
    Color="#FFBDBDBD" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Text45"
    Color="#FFBDBDBD" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Text40"
    Color="#FFBDBDBD" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Text35"
    Color="#FFBDBDBD" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Text30"
    Color="#FFBDBDBD" />
  <!-- Hairlines / faint fills on #F2F2F2 -->
  <SolidColorBrush
    x:Key="Nocturne.Brush.Hairline16"
    Color="#29F2F2F2" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Hairline14"
    Color="#24F2F2F2" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Hairline10"
    Color="#1AF2F2F2" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Hairline08"
    Color="#14F2F2F2" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.Hairline06"
    Color="#0FF2F2F2" />
  <!-- Accent-derived translucent fills -->
  <SolidColorBrush
    x:Key="Nocturne.Brush.AccentHoverFill"
    Color="#1FFF667A" />
  <SolidColorBrush
    x:Key="Nocturne.Brush.FocusGlow"
    Color="#40FF667A" />
  <!-- Fading divider caps (transparent → 16% text) -->
  <LinearGradientBrush
    x:Key="Nocturne.Brush.DividerCapLeft"
    StartPoint="0,0"
    EndPoint="1,0">
    <GradientStop
      Offset="0"
      Color="#00F2F2F2" />
    <GradientStop
      Offset="1"
      Color="#29F2F2F2" />
  </LinearGradientBrush>
  <LinearGradientBrush
    x:Key="Nocturne.Brush.DividerCapRight"
    StartPoint="0,0"
    EndPoint="1,0">
    <GradientStop
      Offset="0"
      Color="#29F2F2F2" />
    <GradientStop
      Offset="1"
      Color="#00F2F2F2" />
  </LinearGradientBrush>
  <LinearGradientBrush
    x:Key="Nocturne.Brush.DividerCapLeft14"
    StartPoint="0,0"
    EndPoint="1,0">
    <GradientStop
      Offset="0"
      Color="#00F2F2F2" />
    <GradientStop
      Offset="1"
      Color="#24F2F2F2" />
  </LinearGradientBrush>
  <LinearGradientBrush
    x:Key="Nocturne.Brush.DividerCapRight14"
    StartPoint="0,0"
    EndPoint="1,0">
    <GradientStop
      Offset="0"
      Color="#24F2F2F2" />
    <GradientStop
      Offset="1"
      Color="#00F2F2F2" />
  </LinearGradientBrush>
</ResourceDictionary>