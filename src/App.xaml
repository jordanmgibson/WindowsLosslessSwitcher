<Application x:Class="WindowsLosslessSwitcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Nocturne.Colors.xaml" />
        <ResourceDictionary Source="/Themes/Nocturne.Typography.xaml" />
        <ResourceDictionary Source="/Themes/Nocturne.Icons.xaml" />
        <ResourceDictionary Source="/Themes/Nocturne.Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
